# Endereço público do site, sem barra no fim. Entra nas meta tags de prévia
# (Open Graph), que exigem URL absoluta para o WhatsApp e as redes carregarem
# a imagem. Copie para .env e ajuste.
VITE_SITE_URL=https://exemplo.com.br

# ── Avisos no Telegram (opcional) ──────────────────────────────────────
# Vão no ambiente do serviço da tranca, nunca no build do site. Sem eles o
# convite funciona igual, apenas não avisa ninguém quando alguém responde.
# O token sai do @BotFather; o chat_id, de https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
